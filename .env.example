# Zkopírujte na .env.local (lokální vývoj) nebo nastavte ve Vercelu:
# Project Settings → Environment Variables

# API klíč z https://resend.com/api-keys (povinné)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Kam chodí poptávky. Nepovinné, výchozí je info@spfgroup.org
MAIL_TO=info@spfgroup.org

# Odesílatel. Doména musí být ověřená v Resendu (DNS záznamy SPF/DKIM),
# jinak odeslání selže. Nepovinné, výchozí je Web SPF Group <web@spfgroup.org>
MAIL_FROM=Web SPF Group <web@spfgroup.org>
